# For `npm run dev` / `npm run build` only. With Docker, set these in the root .env instead
# (see ../.env.example); they are passed to the build as build args.
#
# Where the price data is. Empty: this site's /data (dev server, Docker). On Vercel, the public
# Supabase Storage bucket: https://<project>.supabase.co/storage/v1/object/public/prices
VITE_DATA_URL=

# Optional backend (accounts and price drop alerts). Leave empty to run without one.
# Use the Supabase PUBLISHABLE (anon) key here; it is shipped to browsers. Never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
