# Settings for `docker compose` (copy to .env and fill in what you use).
# .env is git-ignored and excluded from Docker builds. Everything here is optional: with an empty
# .env the app still scrapes and shows all prices; only the features below stay off.

# ------------------------------------------------------------------ container
# Port on this machine for the app (http://localhost:8080).
HOST_PORT=8080
# Days of history fetched when the data volume is empty (rankings need 90).
HISTORY_DAYS=365
# Hour of the daily run in UTC (2 = 10:00 Manila).
REFRESH_UTC=2

# ------------------------------------------------------------------ Supabase (permanent price store)
# Project Settings > API. Use the SECRET key (sb_secret_... or the older service_role key), never
# the publishable key: the price tables only accept the secret key. Run supabase/migrations/*.sql
# in the SQL editor first. Seed once: docker compose exec suki python -m scraper push
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 0 to stop saving to / restoring from Supabase while keeping alerts.
PRICE_DB=1

# ------------------------------------------------------------------ AI weekly notes
# gemini (free tier), openai, or off. Empty: Gemini if GEMINI_API_KEY is set, else OpenAI if
# OPENAI_API_KEY is set, else off.
AI_PROVIDER=
# Google AI Studio > Get API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# platform.openai.com > API keys (prepaid credits; turn auto-recharge off for a hard limit).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# "Why prices moved" web search (1/0). Not in Gemini's free tier; it switches itself off when refused.
AI_WEB_SEARCH=1
# Hard daily caps (UTC day). When reached, AI notes wait until the next day.
AI_DAILY_REQUESTS=40
AI_DAILY_TOKENS=600000

# ------------------------------------------------------------------ app build (accounts and alerts)
# Baked into the app at build time. Use the PUBLISHABLE (anon) key here, never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ------------------------------------------------------------------ price drop alerts (sender)
# Needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above.
VAPID_PRIVATE_KEY=
# mailto: address or https URL identifying the sender to push services.
VAPID_SUBJECT=
# Public URL of the app, used in notification links.
APP_URL=
